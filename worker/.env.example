# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://intac-report.netlify.app,http://localhost:3000

# --- Email recipients (comma-separated) ---
# Optional overrides; defaults are baked into config.js
NONGA_TO=charlie@sentrystrategy.com,charlie@sentrystrategy.com,bill@globalcorrosion.com
NONGA_CC=nick.le@sentrystrategy.com,vananh.le@sentryxp.com
GA_TO=charlie@sentrystrategy.com,charlie@sentrystrategy.com,bill@globalcorrosion.com
GA_CC=nick.le@sentrystrategy.com,vananh.le@sentryxp.com

