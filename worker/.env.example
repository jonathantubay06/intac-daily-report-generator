# --- CRM (Intac Advisory) ---
CRM_URL=https://crm.intacadvisory.com
CRM_USER=Reporting Bot
CRM_PASSWORD=replace-me

# --- Frontend gate ---
# Team password the Netlify site must send in X-Team-Password header
